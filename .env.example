NODE_ENV=development
PORT=3000
# Used when STORAGE_BACKEND=postgres (default when DATABASE_URL is set).
# Works with local Postgres, Supabase hosted, and Supabase self-hosted.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/puzzlebox
# Optional override. Auto-detected by host when omitted.
# DATABASE_SSL=false
# Optional explicit backend selection: memory | postgres
# STORAGE_BACKEND=postgres
# Optional pool tuning
# DATABASE_POOL_MAX=10
# DATABASE_POOL_IDLE_MS=30000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000
JWT_SECRET=replace_with_a_32byte_secret
DEFAULT_TENANT_NAME=Puzzlebox Demo
DEFAULT_TENANT_SLUG=demo
DEFAULT_TENANT_TIMEZONE=America/New_York
DEFAULT_API_KEY=dev-admin-key
MAGIC_LINK_TTL_SECONDS=600
JWT_TTL_SECONDS=86400
STREAK_GRACE_HOURS=3
